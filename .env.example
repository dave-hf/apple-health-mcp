# Shared secret used by both services.
#
# - The ingest service requires the iPhone client to send this as
#   `Authorization: Bearer $HEALTH_TOKEN`.
# - The MCP server embeds this token in its public URL path
#   (`/mcp/<HEALTH_TOKEN>`) because Claude's connector UI does not yet
#   support custom Authorization headers.
#
# Generate a fresh value with:  openssl rand -hex 32
HEALTH_TOKEN=replace-me-with-a-64-char-hex-string

# Where ingested CSV files are written and where the MCP server reads from.
DATA_DIR=/opt/health/data

# Where the scheduled report-generation routine writes daily HEALTH REPORT
# markdown files. The Fitness Coach Agent reads from here via the
# `get_health_report` MCP tool.
REPORTS_DIR=/opt/health/reports
